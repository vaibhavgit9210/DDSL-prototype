# Copy to .env and fill in. NEVER commit .env.
# Aerolink (Anthropic-compatible gateway):
ANTHROPIC_API_KEY=aero_live_...
ANTHROPIC_BASE_URL=https://capi.aerolink.lat
# Or a direct Anthropic key: set ANTHROPIC_API_KEY=sk-ant-... and remove ANTHROPIC_BASE_URL.

# Restrict CORS to the frontend origins in production:
ALLOWED_ORIGINS=*

# Optional: DWG->DXF converter binary (ODA File Converter or dwg2dxf on PATH)
# ODA_CONVERTER=/Applications/ODAFileConverter.app/Contents/MacOS/ODAFileConverter
